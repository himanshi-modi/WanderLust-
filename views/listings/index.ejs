<%-layout("layouts/boilerplate")%>
<style>
    #filters{
        display: flex;
        flex-wrap: wrap;
         
    }
    .filter{
        text-decoration: none;
        color: inherit;
        margin-right: 1.95rem;
        margin-top: 1rem;
        text-align: center;
        opacity: 0.7;
    }
    .filter:hover{
        cursor: pointer;
        opacity: 1;
    }
    .tax-info{
        display: none;
    }
    .tax-toggle{
        border:1px black solid ;
        border-radius: 1rem;
        padding: 1rem;
        height: 3.25rem;
        display: flex;
        align-items: center;
        margin-top: 10px;
    }
    .filter.active{
    opacity: 1;
    border-bottom: 2px solid black;
}
    
</style>
<body>
    <div id="filters">
        <a href="/listings?category=Trending" class="filter <%= selectedCategory === 'Trending' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-fire"></i>
        </div>
        <p>Trending</p>
        </a>
        
        <a href="/listings?category=Farms" class="filter <%= selectedCategory === 'Farms' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-building-wheat"></i>
        </div>
        <p>Farms</p>
        </a>
        <a href="/listings?category=Rooms" class="filter <%= selectedCategory === 'Rooms' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-bed"></i>
        </div>
        <p>Rooms</p>
        </a>
        <a href="/listings?category=Amazing Views" class="filter <%= selectedCategory === 'Amazing Views' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-panorama"></i>
        </div>
        <p>Amazing Views</p>
        </a>
        <a href="/listings?category=Iconic Cities" class="filter <%= selectedCategory === 'Iconic Cities' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-city"></i>
        </div>
        <p>Iconic cities</p>
        </a>
        <a href="/listings?category=Surfing" class="filter <%= selectedCategory === 'Surfing' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-house-tsunami"></i>
        </div>
        <p>Surfing</p>
        </a>
        <a href="/listings?category=Beaches" class="filter <%= selectedCategory === 'Beaches' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-umbrella-beach"></i>
        </div>
        <p>Beachs</p>
        </a>
        <a href="/listings?category=Artics" class="filter <%= selectedCategory === 'Arctics' ? 'active' : '' %>" >
        <div>
            <i class="fa-solid fa-snowflake"></i>
        </div>
        <p>Arctics</p>
    </a>
        <a href="/listings?category=Tree House" class="filter <%= selectedCategory === 'Tree House' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-tree"></i>
        </div>
        <p>Tree house</p>
    </a>
        <a href="/listings?category=Camping" class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-campground"></i>
        </div>
        <p>Camping</p>
    </a>
        <a href="/listings?category=House boat" class="filter <%= selectedCategory === 'House Boat' ? 'active' : '' %>">
        <div>
            <i class="fa-solid fa-ship"></i>
        </div>
        <p>House Boat</p>
    </a>
       
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>

        </div>
    </div>
    <% if(allListings.length === 0){ %>
    <div class="text-center mt-5">
        <h3>No listings found.</h3>
    </div>
<% } %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <%for(let listing of allListings){%>
            <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" style="height: 20rem;" alt="listing_image">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <h5 class="card-title">
                           
                        </h5>
                        <p class="card-text">
                        <b><%=listing.title %></b><br>
                        &#8377; <%=listing.price.toLocaleString("en-IN") %>/ night
                            <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
                </a>
            <%}%>
    </div>
    
    
</body>
<script>
    let taxSwitch=document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
        let taxInfo=document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display!="inline"){
                console.log("show ");
                info.style.display="inline"
            }else{
                info.style.display="none"
            }
        }
    })
</script>
