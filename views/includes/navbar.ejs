<nav class="main-navbar">

  <div class="navbar-inner">

    <!-- Brand -->
    <a href="/listings" class="brand">

      <span class="brand-icon">
        <i class="fa-solid fa-compass"></i>
      </span>

      <span class="brand-name">
        WanderLust
      </span>

    </a>


    <!-- Desktop navigation -->
    <div class="desktop-nav">

      <a href="/listings" class="nav-item">
        Explore
      </a>

    </div>


    <!-- Search -->
    <form
      class="navbar-search"
      action="/listings"
      method="GET"
    >

      <i class="fa-solid fa-magnifying-glass search-icon"></i>

      <input
        type="search"
        name="search"
        value="<%= search || '' %>"
        placeholder="Search destinations"
        aria-label="Search destinations"
      >

      <button type="submit">
        Search
      </button>

    </form>


    <!-- Right navigation -->
    <div class="navbar-actions">

      <a href="/listings/new" class="nav-item add-listing">
        Add Listing
      </a>

      <% if (!currUser) { %>

        <a href="/signup" class="nav-item nav-strong">
          Sign up
        </a>

        <a href="/login" class="nav-item nav-strong">
          Login
        </a>

      <% } %>


      <% if (currUser) { %>

        <a href="/logout" class="nav-item nav-strong">
          Log out
        </a>

      <% } %>

    </div>


    <!-- Mobile menu button -->
    <button
      class="mobile-menu-button"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mobileNav"
      aria-label="Open navigation"
    >
      <i class="fa-solid fa-bars"></i>
    </button>

  </div>


  <!-- Mobile navigation -->
  <div class="collapse mobile-nav" id="mobileNav">

    <div class="mobile-nav-inner">

      <a href="/listings">
        Explore
      </a>

      <a href="/listings/new">
        Add Listing
      </a>

      <% if (!currUser) { %>

        <a href="/signup">
          Sign up
        </a>

        <a href="/login">
          Login
        </a>

      <% } %>

      <% if (currUser) { %>

        <a href="/logout">
          Log out
        </a>

      <% } %>

    </div>

  </div>

</nav>